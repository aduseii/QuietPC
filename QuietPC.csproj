<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10, so the .exe runs with nothing else to install. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>QuietPC</AssemblyName>
    <RootNamespace>QuietPC</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\QuietPC.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Quiet PC</Product>
    <Company>aduseii</Company>
    <Copyright>MIT License</Copyright>
    <Description>Quiets fans by throttling background apps and capping Turbo Boost; trims Microsoft Edge memory.</Description>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(FrameworkPathOverride)' == ''">
    <!-- Lets the project build on any OS, including GitHub's Linux and Windows runners. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
